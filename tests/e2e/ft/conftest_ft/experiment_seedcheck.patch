+def _debug_check_sampler_inputs(batch, *, is_decode: bool) -> None:
+    global _debug_sampler_check_ct
+    from sglang.srt.model_executor.model_runner import DEBUG_SAMPLER_INPUTS
+
+    if batch.sampling_info is None or batch.sampling_info.sampling_seed is None:
+        return
+    if not DEBUG_SAMPLER_INPUTS:
+        logger.error(f"SAMPLERCHECK empty queue is_decode={is_decode} bs={len(batch.reqs)}")
+        return
+    rec_is_decode, seeds, positions = DEBUG_SAMPLER_INPUTS.popleft()
+    seeds, positions = seeds.tolist(), positions.tolist()
+    _debug_sampler_check_ct += 1
+    if _debug_sampler_check_ct % 2000 == 1:
+        logger.info(f"SAMPLERCHECK active ct={_debug_sampler_check_ct} queue_len={len(DEBUG_SAMPLER_INPUTS)}")
+    if rec_is_decode != is_decode or len(seeds) < len(batch.reqs):
+        logger.error(
+            f"SAMPLERCHECK misaligned rec_is_decode={rec_is_decode} is_decode={is_decode} "
+            f"len_seeds={len(seeds)} bs={len(batch.reqs)} queue_len={len(DEBUG_SAMPLER_INPUTS)}"
+        )
+        DEBUG_SAMPLER_INPUTS.clear()
+        return
+    if not is_decode:
+        return
+    bad = []
+    for i, req in enumerate(batch.reqs):
+        if req.finished() or req.is_retracted:
+            continue
+        exp_seed = req.sampling_params.sampling_seed if req.sampling_params.sampling_seed is not None else 42
+        exp_pos = len(req.origin_input_ids) + len(req.output_ids) - 1
+        if seeds[i] != exp_seed or positions[i] != exp_pos:
+            bad.append((i, req.rid[:8], exp_seed, seeds[i], exp_pos, positions[i]))
+    if bad:
+        logger.error(
+            f"SAMPLERCHECK mismatch ct={_debug_sampler_check_ct} bs={len(batch.reqs)} len_seeds={len(seeds)} "
+            f"n_bad={len(bad)} first_bad(i,rid,exp_seed,seed,exp_pos,pos)={bad[:16]}"
+        )
 
 
